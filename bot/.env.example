# === Telegram ===
# Токен бота от @BotFather
BOT_TOKEN=

# === Supabase ===
# URL проекта (Settings → API)
SUPABASE_URL=https://xxxxx.supabase.co
# Anon key или Service Role key
SUPABASE_KEY=

# === OpenAI ===
# API ключ для генерации аватаров (gpt-image-2)
OPENAI_API_KEY=

# === Telegram Mini App ===
# URL мини-аппы (кнопка в меню бота)
MINI_APP_URL=https://notlove-me.vercel.app/app

# === Webhook (необязательно, для продакшна) ===
# Если пусто — бот работает в режиме long-polling
WEBHOOK_URL=
WEBHOOK_PORT=8443
